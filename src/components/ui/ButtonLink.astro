---
import type { HTMLAttributes } from "astro/types";

export interface Props extends Omit<HTMLAttributes<"a">, "class" | "href"> {
  href?: string;
  disabled?: boolean;
  isExternal?: boolean;
  class?: string | string[];
}
const {
  href,
  disabled,
  title,
  target,
  isExternal,
  rel,
  class: className,
} = Astro.props as Props;

const Element = disabled ? "span" : "a";

const relValues = [rel, isExternal ? "noopener noreferrer" : null].filter(
  (value): value is string => Boolean(value),
);
---

<Element
  href={href}
  title={title}
  target={target || (isExternal ? "_blank" : null)}
  rel={relValues.length > 0 ? relValues.join(" ") : null}
  class:list={[
    "inline-block rounded border border-black/50 px-2 py-1",
    href && "hover:bg-black/5",
    disabled && "cursor-not-allowed opacity-50",
    className,
  ]}
  aria-hidden={disabled ? true : null}
>
  <slot />
</Element>
