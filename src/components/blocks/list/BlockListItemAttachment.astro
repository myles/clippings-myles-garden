---
import type { BlockBase } from "@/lib/schemas";
import BlockImageSmall from "../shared/BlockImageSmall.astro";

type Props = {
  block: BlockBase<"Attachment">;
  class?: string[];
};
const { block, class: className } = Astro.props;
---

{block.data.image ? (
  <BlockImageSmall
    image={block.data.image}
    class:list={["block-list-item-attachment", "p-2", className]}
  />
) : (
  <span
    class:list={[
      "block-list-item-attachment",
      "p-2 text-sm text-slate-500 break-all",
      className,
    ]}
  >
    {block.data.attachment.filename}
  </span>
)}
