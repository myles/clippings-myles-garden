---
import type { ImageSchema } from "@/lib/schemas";
import { Image } from "astro:assets";

type Props = {
  image: ImageSchema;
  href?: string;
  isExternal?: boolean;
  class?: string[];
};
const { image, class: className } = Astro.props;

const width = image.square.width ?? 768;
const height = image.square.height ?? 768;
---

<Image
  src={image.src}
  alt={image.alt_text ?? ""}
  width={width}
  height={height}
  widths={[384, 768]}
  sizes="(min-width: 1024px) 25vw, (min-width: 768px) 33vw, (min-width: 640px) 50vw, 100vw"
  quality={75}
  class:list={["w-full h-full object-contain", className]}
/>
